# GitHub Actions secrets for .github/workflows/android-release.yml
# Placeholders only - set the real values in
#   GitHub -> repo Settings -> Secrets and variables -> Actions -> New repository secret
# (or: gh secret set NAME). NEVER commit real values or the keystore.
#
# base64 -w0 android/notchat-release.keystore   (macOS: base64 -i android/notchat-release.keystore)
NOTCHAT_KEYSTORE_BASE64=MIIJ...BASE64_OF_YOUR_KEYSTORE...==
NOTCHAT_KEYSTORE_PASSWORD=YOUR_STORE_PASSWORD_HERE
NOTCHAT_KEY_ALIAS=notchat
NOTCHAT_KEY_PASSWORD=YOUR_KEY_PASSWORD_HERE
